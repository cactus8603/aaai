# Whitelist: only code, configs and paper sources are tracked. Data/results/models are regenerated.
/*
!/.gitignore
!/README.md
!/research/
/research/*
!/research/volatile_trust/
!/research/source_trust/
/research/source_trust/*
!/research/source_trust/model_backends.py
!/research/source_trust/prepare_pet_data.py
/research/volatile_trust/runs*/
/research/volatile_trust/episodes_*/
/research/volatile_trust/astra/
/research/volatile_trust/discussion/
/research/volatile_trust/psych101/examples/
!/paper/
/paper/*
!/paper/main.tex
!/paper/refs.bib
!/paper/aaai2027.sty
!/paper/aaai2027.bst
!/paper/README.md
!/paper/figures/
!/paper/tables/
__pycache__/
*.pyc
.secrets/
/research/volatile_trust/*.sh
/research/volatile_trust/psych101/data/
/research/volatile_trust/suggestion.md
